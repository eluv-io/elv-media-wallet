    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.2.3",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
