    "bad-words": "^3.0.4",
    "country-codes-list": "^1.6.8",
    "dayjs": "^1.11.10",
    "ethers": "^5.7.2",
    "js-money": "^0.6.3",
    "lodash": "^4.17.21",
    "minisearch": "^6.3.0",
    "mobx": "^6.3.3",
    "mobx-react": "^7.2.0",
    "openid-client": "^6.8.4",
    "parse-domain": "^8.2.2",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-inlinesvg": "^4.1.3",
    "react-lines-ellipsis": "^0.15.4",
